# Google OAuth
# Crie credenciais "Aplicativo da Web" no Google Cloud.
# Produção: https://brunosantosbs39-saas-marketplace-de.vercel.app/api/auth/callback
# Local: http://localhost:3000/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gere um segredo longo e aleatório para assinar a sessão.
AUTH_SECRET=

# Banco de dados
DATABASE_URL=

# Envio de e-mail
EMAIL_API_KEY=

# WhatsApp
WHATSAPP_TOKEN=

# n8n
N8N_WEBHOOK_URL=

# OpenAI
# Chave da sua conta na OpenAI. Use somente no servidor. Nunca exponha no navegador.
OPENAI_API_KEY=
